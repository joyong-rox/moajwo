FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build
FROM nginx:1.29-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN sed -i 's|http://backend:8000/|https://moajwo-test-api.onrender.com/|; s|proxy_set_header Host .*;|proxy_set_header Host moajwo-test-api.onrender.com;|' /etc/nginx/conf.d/default.conf \
 && sed -i '/proxy_pass/a\        proxy_ssl_server_name on;' /etc/nginx/conf.d/default.conf \
 && nginx -t
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
